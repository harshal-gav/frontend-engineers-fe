generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────

enum RemoteType {
  ONSITE
  HYBRID
  REMOTE
}

enum ExperienceLevel {
  ENTRY
  MID
  SENIOR
  LEAD
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum JobStatus {
  ACTIVE
  CLOSED
}

enum SubscriptionPlan {
  FREE
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  INCOMPLETE
}

enum AlertFrequency {
  NONE
  INSTANT
  DAILY
  WEEKLY
}

enum UserRole {
  USER
  ADMIN
}

enum ScraperRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

// ─── Models ──────────────────────────────────────────────────────

model Company {
  id              String       @id @default(cuid())
  name            String
  logoUrl         String?
  careersUrl      String
  website         String?
  industry        String?
  description     String?
  atsType         String?      // greenhouse, lever, ashby, workday, custom
  boardUrl        String?      // ATS board URL if different from careersUrl
  scraperConfig   Json?        // Inline scraper config (selectors, pagination, etc.)
  crawlIntervalH  Int          @default(12)
  isActive        Boolean      @default(true)
  lastScrapedAt   DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  jobs        Job[]
  scraperRuns ScraperRun[]

  @@index([isActive])
}

model Job {
  id              String          @id @default(cuid())
  companyId       String
  title           String
  description     String?         @db.Text
  applyUrl        String
  location        String?         // Raw location string
  city            String?
  state           String?
  country         String?
  remoteType      RemoteType      @default(ONSITE)
  salaryMin       Int?
  salaryMax       Int?
  currency        String?         @default("USD")
  experienceLevel ExperienceLevel?
  employmentType  EmploymentType  @default(FULL_TIME)
  department      String?
  postedAt        DateTime?
  scrapedAt       DateTime        @default(now())
  status          JobStatus       @default(ACTIVE)
  sourceHash      String          @unique // sha256(companyId + title + location + postedAt)

  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  savedBy   SavedJob[]

  @@index([status, postedAt(sort: Desc)])
  @@index([companyId])
  @@index([remoteType])
  @@index([experienceLevel])
  @@index([employmentType])
  @@index([city])
  @@index([country])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  image         String?
  oauthProvider String?   // google, github, etc.
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subscription  Subscription?
  savedJobs     SavedJob[]
  savedSearches SavedSearch[]
  accounts      Account[]
  sessions      Session[]
}

// NextAuth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String             @unique
  stripeCustomerId  String?            @unique
  stripeSubId       String?            @unique
  plan              SubscriptionPlan   @default(FREE)
  status            SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedJob {
  id      String   @id @default(cuid())
  userId  String
  jobId   String
  savedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model SavedSearch {
  id             String         @id @default(cuid())
  userId         String
  name           String
  filters        Json           // Stored filter state
  alertFrequency AlertFrequency @default(NONE)
  lastAlertedAt  DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ScraperRun {
  id          String           @id @default(cuid())
  companyId   String
  startedAt   DateTime         @default(now())
  completedAt DateTime?
  jobsFound   Int              @default(0)
  jobsClosed  Int              @default(0)
  jobsCreated Int              @default(0)
  errors      Int              @default(0)
  errorLog    String?          @db.Text
  status      ScraperRunStatus @default(RUNNING)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, startedAt(sort: Desc)])
}
